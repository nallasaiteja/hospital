# Django Configuration
DJANGO_SECRET_KEY=django-insecure-hms-core-development-key-change-in-prod-xyz
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase / PostgreSQL Database Connection
# DIRECT_URL is used for migrations (direct session connection on port 5432)
# DATABASE_URL is used for application queries (can be transaction pooler on port 6543 or direct)


# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL=postgresql://postgres.yourprojectref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL=postgresql://postgres.yourprojectref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Supabase Project Credentials
SUPABASE_URL=https://yourprojectref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-service-role-key

# Timezone & Regional Settings
TIME_ZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
